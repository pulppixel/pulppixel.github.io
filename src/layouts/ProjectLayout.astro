---
interface Props {
  title: string;
  subtitle: string;
  period: string;
  role: string;
  team?: string;
  tags: string[];
  links?: { label: string; url: string }[];
  badge?: string;
  ogImage?: string;
}

const { title, subtitle, period, role, team, tags, links, badge, ogImage } = Astro.props;

const resolvedOg = ogImage
    ? (ogImage.startsWith('http') ? ogImage : `https://pulppixel.github.io${ogImage}`)
    : 'https://pulppixel.github.io/og.png?v=2';

// 프로젝트 순서 (터미널 data.ts 프로젝트 순서와 동일한 흐름)
const projectOrder = [
  { slug: 'eterna', title: 'ETERNA' },
  { slug: 'reiw', title: 'REIW' },
  { slug: 'iw-zombie', title: 'IW Zombie' },
  { slug: 'frenzy-circle', title: 'Nine to Six' },
  { slug: 'stelsi-wallet', title: 'STELSI Wallet' },
  { slug: 'stelsi', title: 'STELSI UE5' },
  { slug: 'nomads-planet', title: 'Nomads Planet' },
  { slug: 'math-master', title: 'Math Master' },
  { slug: 'spody', title: 'SPODY' },
  { slug: 'ruby-adventure', title: '루비의 모험' },
];

const currentSlug = Astro.url.pathname.replace(/^\/projects\//, '').replace(/\/$/, '');
const currentIdx = projectOrder.findIndex(p => p.slug === currentSlug);
const prev = currentIdx > 0 ? projectOrder[currentIdx - 1] : null;
const next = currentIdx >= 0 && currentIdx < projectOrder.length - 1 ? projectOrder[currentIdx + 1] : null;

// Slug -> minigame key (scripts/core/data.ts 와 동기 유지)
const minigameMap: Record<string, string> = {
  'math-master':    'maze',
  'spody':          'spody',
  'ruby-adventure': 'ruby',
  'nomads-planet':  'nomads',
  'frenzy-circle':  'ninetosix',
};
const minigameKey = minigameMap[currentSlug];

const pageTitle = `${title} — Pulppixel`;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={subtitle} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="author" content="Hwankee Baik" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={`https://pulppixel.github.io${Astro.url.pathname}`} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://pulppixel.github.io${Astro.url.pathname}`} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={subtitle} />
  <meta property="og:image" content={resolvedOg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:site_name" content="Pulppixel" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={subtitle} />
  <meta name="twitter:image" content={resolvedOg} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/d2coding@1.3.2/d2coding-subset.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/@fontsource/cascadia-code/400.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/@fontsource/cascadia-code/700.css" rel="stylesheet" />
</head>
<body>
  <main class="frame">
    <!-- 타이틀바 (Ghostty 윈도우 크롬) -->
    <header class="titlebar">
      <div class="lights">
        <span style="background:#eb6f92"></span>
        <span style="background:#f6c177"></span>
        <span style="background:#9ccfd8"></span>
      </div>
      <div class="tab">
        <div class="tab-chip">
          <span class="t-host">hwankee@pulppixel</span><span class="t-colon">:</span><span class="t-path">~/portfolio</span>
        </div>
      </div>
      <a href="/explore/" class="world-link" title="3D 월드"><span style="color:#9ccfd8">❯</span> 3d-world</a>
    </header>

    <!-- cat 헤더 (인앱 상세와 동일한 줄) -->
    <div class="catbar">
      <div class="catpath"><span class="cmd">cat</span> ~/portfolio/projects/{currentSlug}.md</div>
      <a href="/" class="back">back (esc)</a>
    </div>

    <article class="content">
      <div class="eyebrow">PROJECT</div>
      <div class="title-row">
        <h1>{title.split(' - ')[0].split(' — ')[0]}</h1>
        {badge && <span class="badge">{badge}</span>}
      </div>
      <p class="subtitle">{subtitle}</p>
      <div class="period">{period}</div>

      <div class="meta-row">
        {role && <span class="chip"><span class="chip-k">역할</span>: {role}</span>}
        {team && <span class="chip"><span class="chip-k">팀</span>: {team}</span>}
        {links && links.map(l => (
          <a class="chip chip-link" href={l.url} target="_blank" rel="noopener">{l.label}</a>
        ))}
        {minigameKey && (
          <a class="cta-play" href={`/play/${minigameKey}/`}>미니게임 하러 가기</a>
        )}
      </div>

      <div class="rule"></div>

      <div class="detail-content">
        <slot />
      </div>

      <nav class="proj-nav">
        {prev ? (
          <a href={`/projects/${prev.slug}/`} class="nav-prev">
            <span class="nav-dir">이전</span>
            <span class="nav-title">{prev.title}</span>
          </a>
        ) : <div />}
        {next ? (
          <a href={`/projects/${next.slug}/`} class="nav-next">
            <span class="nav-dir">다음</span>
            <span class="nav-title">{next.title}</span>
          </a>
        ) : <div />}
      </nav>

      <div class="foot">
        <a href="/" class="foot-back">back to gui</a>
      </div>
    </article>
  </main>

  <script is:inline>
    // esc / q 로 홈(터미널)으로 복귀 — 인앱 상세와 동일한 조작감
    document.addEventListener('keydown', (e) => {
      const t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA')) return;
      if (e.key === 'Escape' || e.key === 'q') window.location.href = '/';
    });
  </script>
</body>
</html>

<style is:global>
  /* YouTube.astro 등 슬롯 컴포넌트가 참조하는 변수 호환(Rosé Pine) */
  :root { --border: #26233a; --bg-card: #1f1d2e; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { background: #13111c; min-height: 100%; }
  a { color: inherit; text-decoration: none; }
  ::selection { background: #c4a7e7; color: #191724; }
  ::-webkit-scrollbar { width: 9px; height: 9px; }
  ::-webkit-scrollbar-thumb { background: #403d52; border-radius: 6px; border: 2px solid transparent; background-clip: padding-box; }
  ::-webkit-scrollbar-thumb:hover { background: #524f67; background-clip: padding-box; }
  ::-webkit-scrollbar-track { background: transparent; }
  body {
    font-family: 'CaskaydiaCove Nerd Font', 'Cascadia Code', 'D2Coding', 'JetBrains Mono', monospace;
    -webkit-font-smoothing: antialiased;
    color: #cdc9de;
    padding: clamp(0px, 4vw, 52px);
    min-height: 100vh;
    /* index.astro #app 배경과 동일한 그라데이션 — 홈↔상세 전환 시 톤 유지 */
    background:
      radial-gradient(60% 50% at 80% 8%, rgba(196,167,231,.32) 0%, rgba(196,167,231,0) 60%),
      radial-gradient(55% 48% at 14% 90%, rgba(122,162,247,.20) 0%, rgba(122,162,247,0) 58%),
      radial-gradient(46% 42% at 92% 95%, rgba(235,188,186,.13) 0%, rgba(235,188,186,0) 62%),
      linear-gradient(150deg, #241d3a 0%, #1a1626 46%, #100e18 100%);
    background-attachment: fixed;
  }
</style>

<style>
  /* backdrop-filter 는 문서 전체가 스크롤되는 장신(長身) 프레임에서 Chromium 페인트 버그를
     일으키므로 사용하지 않음. 대신 불투명 base 로 칠하고 주변 그라데이션으로 부유감만 유지. */
  .frame {
    position: relative;
    width: min(1040px, 100%);
    margin: 0 auto;
    background: #1a1826;
    border: 1px solid #524f67;
    border-radius: 12px;
    box-shadow: 0 40px 120px -30px rgba(0,0,0,.85), 0 0 0 1px rgba(196,167,231,.06);
    overflow: hidden;
  }

  /* ── 타이틀바 ── */
  .titlebar {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; gap: 14px;
    height: 42px; padding: 0 16px;
    background: #1f1d2e; border-bottom: 1px solid #16141f;
  }
  .lights { display: flex; gap: 8px; flex: none; }
  .lights span { width: 12px; height: 12px; border-radius: 50%; display: block; }
  .tab {
    flex: 1; display: flex; justify-content: center; min-width: 0;
  }
  /* 홈(터미널) 타이틀바의 탭 칩과 동일 */
  .tab-chip {
    display: flex; align-items: center; background: #191724; border: 1px solid #403d52;
    border-radius: 6px; padding: 5px 16px; font-size: 12px; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .t-host { color: #e0def4; }
  .t-colon { color: #6e6a86; }
  .t-path { color: #9ccfd8; }
  .world-link {
    flex: none; font-size: 11px; color: #908caa; letter-spacing: .04em; white-space: nowrap;
    border: 1px solid #403d52; border-radius: 6px; padding: 4px 10px; transition: border-color .2s, color .2s;
  }
  .world-link:hover { border-color: #9ccfd8; color: #e0def4; }

  /* ── cat 헤더 ── */
  .catbar {
    position: sticky; top: 42px; z-index: 19;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 8px 16px; background: #1f1d2e; border-bottom: 1px solid #16141f; font-size: 12px;
  }
  .catpath { color: #6e6a86; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .catpath .cmd { color: #9ccfd8; }
  .back {
    flex: none; border: 1px solid #403d52; color: #908caa;
    padding: 6px 12px; border-radius: 6px; white-space: nowrap; transition: border-color .2s, color .2s;
  }
  .back:hover { border-color: #9ccfd8; color: #e0def4; }

  /* ── 본문 ── */
  .content {
    max-width: 760px; margin: 0 auto;
    padding: clamp(28px, 5vw, 56px) clamp(20px, 5vw, 40px) 80px;
  }
  .eyebrow { font-size: 11px; color: #9ccfd8; letter-spacing: .14em; }
  .title-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 16px; }
  .title-row h1 {
    font-size: clamp(2rem, 5vw, 3rem); color: #e0def4; line-height: 1.06;
    letter-spacing: -.01em; font-weight: 700;
  }
  .badge {
    white-space: nowrap; font-size: 12px; letter-spacing: .06em;
    padding: 4px 12px; border-radius: 6px;
    border: 1px solid #c4a7e7; color: #c4a7e7;
  }
  .subtitle { margin-top: 14px; color: #c4a7e7; font-size: 15px; line-height: 1.7; max-width: 64ch; }
  .period { margin-top: 6px; color: #6e6a86; font-size: 13px; }

  .meta-row { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .chip {
    font-size: 12px; color: #cdc9de; border: 1px solid #26233a;
    border-radius: 6px; padding: 6px 12px; line-height: 1.5;
  }
  .chip-k { color: #9ccfd8; }
  .chip-link { color: #9ccfd8; transition: border-color .2s, background-color .2s; }
  .chip-link:hover { border-color: #9ccfd8; background: rgba(156,207,216,.08); }
  .cta-play {
    font-size: 12px; white-space: nowrap; font-weight: 700;
    background: #9ccfd8; color: #191724; border-radius: 6px; padding: 7px 14px; transition: filter .2s;
  }
  .cta-play:hover { filter: brightness(1.08); }

  .rule { margin-top: 32px; height: 1px; background: #26233a; }

  /* ── 슬롯 콘텐츠 (마크다운형) ── */
  .detail-content { margin-top: 32px; }
  .detail-content :global(h2) {
    font-size: clamp(1rem, 2.4vw, 1.2rem); color: #9ccfd8; letter-spacing: .04em;
    font-weight: 700; margin-top: 40px; margin-bottom: 16px; line-height: 1.4;
  }
  .detail-content :global(h2::before) { content: '# '; color: #c4a7e7; }
  .detail-content :global(h2:first-child) { margin-top: 0; }
  .detail-content :global(p) {
    font-size: 14px; color: #cdc9de; line-height: 1.9; margin-bottom: 16px; max-width: 68ch;
  }
  .detail-content :global(strong) { color: #e0def4; font-weight: 700; }
  .detail-content :global(a) { color: #9ccfd8; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #403d52; }
  .detail-content :global(a:hover) { text-decoration-color: #9ccfd8; }
  .detail-content :global(ul) { list-style: none; padding: 0; margin: 0 0 24px; }
  .detail-content :global(li) {
    font-size: 13px; color: #cdc9de; line-height: 1.8; padding-left: 1.4rem;
    position: relative; margin-bottom: 8px; max-width: 68ch;
  }
  .detail-content :global(code) {
    font-family: 'D2Coding', 'JetBrains Mono', monospace; font-size: 12px;
    background: #21202e; border: 1px solid #26233a; color: #ebbcba;
    padding: .1rem .42rem; border-radius: 4px;
  }
  .detail-content :global(img) {
    display: block; width: 100%; border-radius: 8px;
    border: 1px solid #26233a; margin: 24px 0;
  }
  .detail-content :global(.media-placeholder) {
    background: #1f1d2e; border: 1px dashed #403d52; border-radius: 8px;
    padding: 3rem 2rem; text-align: center; color: #6e6a86; font-size: 13px; margin: 24px 0;
  }

  /* ── prev / next ── */
  .proj-nav {
    display: flex; justify-content: space-between; gap: 16px;
    margin-top: 48px; padding-top: 32px; border-top: 1px solid #26233a;
  }
  .proj-nav a {
    display: flex; flex-direction: column; gap: 4px;
    padding: 12px 16px; border: 1px solid #403d52; border-radius: 8px;
    min-width: 150px; transition: border-color .2s, background-color .2s;
  }
  .proj-nav a:hover { border-color: #9ccfd8; background: rgba(156,207,216,.06); }
  .nav-prev { align-items: flex-start; }
  .nav-next { align-items: flex-end; }
  .nav-dir { font-size: 11px; color: #6e6a86; letter-spacing: .04em; }
  .nav-title { font-size: 14px; color: #cdc9de; font-weight: 500; }
  .proj-nav a:hover .nav-title { color: #9ccfd8; }

  .foot {
    margin-top: 40px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    font-size: 12px;
  }
  .foot-back {
    border: 1px solid #403d52; color: #908caa; padding: 10px 20px; border-radius: 8px; transition: border-color .2s, color .2s;
  }
  .foot-back:hover { border-color: #9ccfd8; color: #e0def4; }

  @media (max-width: 720px) {
    .world-link { display: none; }
    .proj-nav { flex-direction: column; }
    .nav-next { align-items: flex-start; }
  }
</style>
