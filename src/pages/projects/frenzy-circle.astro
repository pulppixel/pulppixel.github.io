---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { renderMd } from '../../scripts/terminal/markdown';
import body from '../../content/projects/frenzy-circle.md?raw';
---

<ProjectLayout
    title="Nine to Six (Frenzy Circle)"
    ogImage="/images/ninetosix.png"
    subtitle="TON 생태계 레퍼런스에 맞춰 텔레그램 환경(WebGL)에서 구동되는 미니 게임을 처음부터 설계. 중독성 있는 게임플레이와 랭킹 시스템."
    period="2024.06 - 2024.10"
    role="게임 로직 개발"
    team="3인 (클라이언트, 백엔드, 아트)"
    tags={['Unity', 'C#', 'WebGL', 'RESTful API', 'AWS']}
    badge="3인"
>
  <Fragment set:html={renderMd(body)} />
</ProjectLayout>
