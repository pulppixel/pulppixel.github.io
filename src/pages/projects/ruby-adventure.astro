---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { renderMd } from '../../scripts/terminal/markdown';
import body from '../../content/projects/ruby-adventure.md?raw';
---

<ProjectLayout
    title="루비의 모험"
    ogImage="/images/ruby_boss.png"
    subtitle="기획부터 구현까지 1인 개발로 완성한 3D 액션 RPG. 클릭 기반 이동 및 콤보 전투, NavMesh 기반 AI 등 핵심 게임 시스템을 독자적으로 설계 및 개발했습니다. 재학생 대표로 발표도 했습니다."
    period="2019.09 - 2019.11"
    role="기획, 설계, 구현, 레벨디자인 (1인)"
    team="1인"
    tags={['Unity', 'C#', 'NavMesh', 'Timeline', 'StateMachineBehaviour', 'ScriptableObject']}
    links={[
      { label: 'Source Code', url: 'https://github.com/pulppixel/pulppixel.github.io/tree/main/code-samples/ruby-adventure' },
      { label: 'YouTube', url: 'https://youtube.com/playlist?list=PLUkUNnTP7B0J-yPCv_mcniMEN9127LwC4' },
    ]}
    badge="우수상"
>
  <Fragment set:html={renderMd(body)} />
</ProjectLayout>
