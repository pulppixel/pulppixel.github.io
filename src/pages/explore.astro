---
// No layout wrapper - this is a fullscreen 3D experience
const title = '3D 월드 — Pulppixel';
const description = '포트폴리오를 캐릭터로 직접 돌아다니며 보는 3D 월드. Three.js로 만든 지형 위에 시간·계절·날씨가 흐르고, 프로젝트 큐브를 열어보거나 미니게임에 입장할 수 있습니다.';
const og = 'https://pulppixel.github.io/og.png';
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="author" content="Hwankee Baik" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://pulppixel.github.io/explore/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://pulppixel.github.io/explore/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:site_name" content="Pulppixel" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Nanum+Gothic+Coding:wght@400;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/@fontsource/cascadia-code/400.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/@fontsource/cascadia-code/700.css" rel="stylesheet" />
  <style>
    /* Rosé Pine 팔레트 — 터미널 홈(index.astro)과 톤 통일. accent=foam/iris */
    :root {
      --bg: #191724; --surface: #1f1d2e; --overlay: #26233a;
      --hl-med: #403d52; --hl-high: #524f67;
      --muted: #6e6a86; --subtle: #908caa; --text: #e0def4;
      --love: #eb6f92; --gold: #f6c177; --rose: #ebbcba;
      --pine: #31748f; --foam: #9ccfd8; --iris: #c4a7e7;
      --panel-bg: rgba(25,23,36,0.92);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #13111c; overflow: hidden; font-family: 'Cascadia Code', 'D2Coding', 'Nanum Gothic Coding', 'JetBrains Mono', 'Courier New', monospace; touch-action: none; -webkit-user-select: none; user-select: none; color: var(--text); }
    canvas { display: block; }
    ::selection { background: var(--iris); color: var(--bg); }
    #nav { position: absolute; top: max(16px, env(safe-area-inset-top)); left: max(20px, env(safe-area-inset-left)); right: max(20px, env(safe-area-inset-right)); display: flex; justify-content: space-between; align-items: center; z-index: 15; pointer-events: none; }
    #nav > * { pointer-events: auto; }
    .logo { font-size: 13px; font-weight: 700; letter-spacing: -0.02em; text-decoration: none; color: var(--text); }
    .logo span { color: var(--iris); }
    .nav-links { display: flex; gap: 8px; align-items: center; }
    .nav-links a { font-size: 10px; color: var(--muted); text-decoration: none; letter-spacing: 0.06em; transition: color 0.2s, border-color 0.2s; padding: 4px 10px; border: 1px solid transparent; border-radius: 6px; }
    .nav-links a:hover { color: var(--text); }
    .classic-link { border-color: var(--hl-med) !important; color: var(--subtle) !important; }
    .classic-link:hover { border-color: var(--foam) !important; color: var(--foam) !important; }
    .is-mobile .nav-links .hide-mobile { display: none; }
    #hero-label { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none; text-align: center; opacity: 0; animation: heroIn 2s ease forwards 0.3s; transition: opacity 0.8s; z-index: 5; }
    #hero-label.hidden { opacity: 0 !important; animation: none; }
    #hero-label h1 { font-size: 15px; color: var(--iris); letter-spacing: 0.15em; margin-bottom: 6px; }
    #hero-label h1::before { content: '❯ '; color: var(--foam); }
    #hero-label p { font-size: 11px; color: var(--muted); letter-spacing: 0.08em; }
    @keyframes heroIn { from { opacity:0; transform:translate(-50%,-45%); } to { opacity:1; transform:translate(-50%,-50%); } }
    #quest-log { position: absolute; top: calc(40px + max(16px, env(safe-area-inset-top))); left: max(20px, env(safe-area-inset-left)); width: 214px; z-index: 12; font-size: 11px; border: 1px solid var(--hl-med); border-radius: 7px; background: var(--panel-bg); backdrop-filter: blur(8px); padding: 13px 11px 10px; }
    .quest-header { color: var(--iris); font-size: 11px; letter-spacing: 0.08em; margin-bottom: 9px; display: flex; align-items: center; gap: 7px; cursor: pointer; animation: questPulse 3s ease 2s 3; }
    @keyframes questPulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
    .quest-icon { color: var(--foam); }
    #quest-toggle { margin-left: auto; background: none; border: none; color: var(--muted); cursor: pointer; font-size: 10px; font-family: inherit; }
    .quest-item { display: flex; align-items: center; gap: 6px; padding: 2px 0; color: var(--muted); font-size: 10px; transition: color 0.3s; }
    .quest-item.visited { color: var(--foam); }
    .quest-item .check { width: 12px; flex-shrink: 0; }
    .quest-item.visited .check::after { content: '✓'; }
    .quest-item:not(.visited) .check::after { content: '○'; }
    .warp-item { display: flex; align-items: center; gap: 7px; padding: 5px 10px; color: var(--subtle); font-size: 10px; cursor: pointer; transition: color 0.2s, background 0.2s, border-color 0.2s; border-radius: 6px; border: 1px solid var(--overlay); background: rgba(31,29,46,0.5); margin-bottom: 3px; }
    .warp-item:hover { color: var(--foam); background: rgba(156,207,216,0.09); border-color: var(--foam); }
    .warp-arrow { margin-left: auto; color: var(--hl-med); font-size: 9px; }
    .warp-item:hover .warp-arrow { color: var(--foam); }
    .warp-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .quest-progress { display: flex; align-items: center; gap: 7px; margin: 8px 0 6px; padding: 0 2px; }
    .quest-bar { flex: 1; height: 3px; background: var(--overlay); border-radius: 2px; overflow: hidden; }
    #quest-fill { height: 100%; width: 0%; background: var(--foam); transition: width 0.5s ease; }
    #quest-count { font-size: 10px; color: var(--muted); white-space: nowrap; }
    #quest-reset { background: none; border: 1px solid var(--hl-med); color: var(--muted); font-size: 9px; padding: 4px 8px; border-radius: 6px; cursor: pointer; transition: color 0.2s, border-color 0.2s; width: 100%; font-family: inherit; } #quest-reset:hover { border-color: var(--foam); color: var(--foam); }
    #interact-hint { position: absolute; top: 50%; left: 50%; transform: translate(-50%, 60px); pointer-events: none; text-align: center; font-size: 12px; color: var(--foam); letter-spacing: 0.06em; opacity: 0; transition: opacity 0.3s; z-index: 6; }
    #interact-hint.show { opacity: 1; }
    .key { display: inline-block; border: 1px solid var(--foam); color: var(--foam); border-radius: 4px; padding: 1px 7px; font-size: 11px; }
    .mobile-hint { display: none; }
    .is-mobile .desktop-hint { display: none; }
    .is-mobile .mobile-hint { display: inline; }
    #project-label { position: absolute; pointer-events: none; padding: 7px 14px; background: var(--panel-bg); border: 1px solid var(--hl-med); border-radius: 7px; color: var(--text); font-size: 12px; letter-spacing: 0.04em; display: none; backdrop-filter: blur(8px); white-space: nowrap; left: 50%; top: 38%; transform: translateX(-50%); z-index: 6; }
    .lbl-period { font-size: 10px; color: var(--muted); margin-top: 3px; }
    .lbl-badge { display: inline-block; font-size: 9px; padding: 1px 7px; border-radius: 4px; margin-left: 6px; letter-spacing: 0.06em; }
    #joystick-base { position: absolute; display: none; pointer-events: none; z-index: 10; width: 110px; height: 110px; border-radius: 50%; border: 1.5px solid rgba(156,207,216,0.22); background: rgba(156,207,216,0.04); transform: translate(-50%, -50%); }
    #joystick-base.active { display: block; }
    #joystick-thumb { position: absolute; width: 44px; height: 44px; border-radius: 50%; background: rgba(156,207,216,0.2); border: 1px solid rgba(156,207,216,0.4); top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none; }
    #joystick-thumb.active { background: rgba(156,207,216,0.45); }
    #mobile-interact { position: absolute; bottom: calc(54px + env(safe-area-inset-bottom)); right: max(28px, env(safe-area-inset-right)); width: 56px; height: 56px; border-radius: 12px; border: 1.5px solid rgba(156,207,216,0.3); background: rgba(156,207,216,0.07); backdrop-filter: blur(6px); color: var(--foam); font-size: 11px; font-family: inherit; display: none; align-items: center; justify-content: center; z-index: 11; cursor: pointer; transition: background 0.15s, transform 0.15s; }
    .is-mobile #mobile-interact.show { display: flex; }
    #mobile-interact:active { background: rgba(156,207,216,0.3); transform: scale(0.93); }
    #mobile-jump { position: absolute; bottom: calc(124px + env(safe-area-inset-bottom)); right: max(28px, env(safe-area-inset-right)); width: 56px; height: 56px; border-radius: 12px; border: 1.5px solid rgba(156,207,216,0.22); background: rgba(156,207,216,0.05); backdrop-filter: blur(6px); color: var(--foam); font-size: 16px; font-family: inherit; display: none; align-items: center; justify-content: center; z-index: 11; cursor: pointer; transition: background 0.15s, transform 0.15s; }
    .is-mobile #mobile-jump { display: flex; }
    #mobile-jump:active { background: rgba(156,207,216,0.3); transform: scale(0.93); }
    #controls-hint { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); color: var(--subtle); font-size: 11px; letter-spacing: 0.08em; pointer-events: none; opacity: 0; animation: heroIn 1.5s ease forwards 1.5s; z-index: 5; }
    .is-mobile #controls-hint { bottom: calc(8px + env(safe-area-inset-bottom)); font-size: 10px; animation-delay: 1s; }
    #fps { position: absolute; bottom: max(16px, env(safe-area-inset-bottom)); right: max(20px, env(safe-area-inset-right)); color: var(--muted); font-size: 10px; z-index: 5; pointer-events: none; }
    #crosshair { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 6px; height: 6px; border: 1px solid var(--foam); border-radius: 50%; pointer-events: none; z-index: 5; display: none; }
    body:not(.is-mobile) #crosshair { display: block; }
    #zone-hint { position: absolute; left: 0; right: 0; top: 65%; height: 1px; background: linear-gradient(90deg, transparent 5%, rgba(156,207,216,0.12) 50%, transparent 95%); pointer-events: none; z-index: 3; opacity: 0; }
    .is-mobile #zone-hint { opacity: 1; animation: zoneHintFade 4s ease forwards 3s; }
    @keyframes zoneHintFade { to { opacity: 0; } }
    @media (max-width: 520px) { #quest-log { width: 170px; font-size: 10px; } }
    #sound-toggle {
      background: transparent; border: 1px solid var(--hl-med);
      color: var(--foam); height: 26px; padding: 0 9px; border-radius: 6px;
      cursor: pointer; font-size: 10px; letter-spacing: 0.06em; font-family: inherit;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.2s, border-color 0.2s, background 0.2s;
    }
    #sound-toggle:hover { border-color: var(--foam); background: rgba(156,207,216,0.08); }
    #sound-toggle.off { color: var(--muted); }
    #sound-toggle.off:hover { border-color: var(--muted); background: transparent; }
    #tw-panel {
      position: absolute; bottom: 20px; left: 20px; width: 196px;
      background: var(--panel-bg); border: 1px solid var(--hl-med);
      border-radius: 7px; padding: 8px 10px; backdrop-filter: blur(8px);
      z-index: 12; font-size: 10px;
    }
    .tw-label { color: var(--muted); font-size: 9px; letter-spacing: 0.1em; margin-bottom: 5px; margin-top: 8px; }
    .tw-label:first-child { margin-top: 0; }
    .tw-row { display: flex; flex-wrap: wrap; gap: 4px; }
    .tw-row button {
      background: transparent; border: 1px solid var(--overlay);
      color: var(--subtle); font-size: 10px; padding: 3px 8px; border-radius: 6px;
      cursor: pointer; font-family: inherit; transition: color 0.2s, border-color 0.2s, background 0.2s;
    }
    .tw-row button:hover { border-color: var(--hl-high); color: var(--text); }
    .tw-row button.tw-on { border-color: var(--foam); color: var(--foam); background: rgba(156,207,216,0.09); }
    .is-mobile #tw-panel { bottom: max(12px, env(safe-area-inset-bottom)); left: max(12px, env(safe-area-inset-left)); }
    @media (max-width: 520px) { #tw-panel { font-size: 9px; } .tw-row button { padding: 3px 6px; } }
    .tw-row button.sk-on { border-color: var(--gold); color: var(--gold); background: rgba(246,193,119,0.09); }
    #tw-toggle {
      position: absolute; bottom: max(20px, env(safe-area-inset-bottom)); left: max(20px, env(safe-area-inset-left));
      width: 32px; height: 32px; border-radius: 7px;
      border: 1px solid var(--hl-med);
      background: var(--panel-bg); backdrop-filter: blur(8px);
      color: var(--foam); font-size: 16px; font-family: inherit;
      cursor: pointer; z-index: 13;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.2s, border-color 0.2s;
    }
    #tw-toggle:hover { border-color: var(--foam); }

    #tw-panel {
      position: absolute; bottom: max(20px, env(safe-area-inset-bottom)); left: max(20px, env(safe-area-inset-left));
      max-height: calc(100dvh - 60px);
      overflow-y: auto;
      padding-top: 32px;
      transition: opacity 0.2s, transform 0.2s;
    }
    #tw-panel.tw-closed {
      opacity: 0; pointer-events: none; transform: translateY(8px);
    }
    #tw-close {
      position: absolute; top: 6px; right: 6px;
      width: 22px; height: 22px;
      background: var(--surface);
      border: 1px solid var(--hl-med);
      color: var(--subtle); font-size: 14px;
      border-radius: 6px; cursor: pointer;
      font-family: inherit;
      display: flex; align-items: center; justify-content: center;
      padding: 0; z-index: 1;
    }
    #tw-close:hover { color: var(--text); border-color: var(--hl-high); }
    #tw-title {
      position: absolute; top: 9px; left: 12px;
      font-size: 10px; color: var(--iris);
      letter-spacing: 0.1em;
      font-family: inherit;
    }
    @media (max-width: 520px) {
      #tw-panel {
        max-height: 60vh;
        background: var(--panel-bg);
        backdrop-filter: blur(8px);
      }
    }
    #quest-log, #tw-panel, #tw-toggle, #controls-hint, #fps, #crosshair, #nav .nav-links, #interact-hint, #project-label { transition: opacity 0.35s ease; }
    body.walking-mode #quest-log, body.walking-mode #tw-panel, body.walking-mode #tw-toggle, body.walking-mode #controls-hint, body.walking-mode #fps, body.walking-mode #crosshair, body.walking-mode #nav .nav-links, body.walking-mode #interact-hint, body.walking-mode #project-label, body.walking-mode #gem-counter { opacity: 0 !important; pointer-events: none !important; }
  </style>
</head>
<body>
<div id="nav">
  <a href="/" class="logo">pulppixel<span>.</span></a>
  <div class="nav-links">
    <a href="/" class="classic-link">classic view</a>
    <a href="https://github.com/pulppixel" target="_blank" class="hide-mobile">github</a>
    <a href="mailto:devenvy100@gmail.com" class="hide-mobile">email</a>
    <button id="sound-toggle" title="Toggle sound">sound</button>
  </div>
</div>

<div id="hero-label"><h1>pulppixel</h1><p>Game Client Engineer, explore my projects</p></div>
<div id="controls-hint">
  <span class="desktop-hint">WASD - MOVE, SHIFT - RUN, SPACE - JUMP, V - WALK, MOUSE - LOOK, E - INTERACT</span>
  <span class="mobile-hint">아래 - 이동, 위 - 회전, ▲ - 점프, E - 상호작용</span>
</div>
<div id="interact-hint"><span class="desktop-hint"><span class="key">E</span> interact</span><span class="mobile-hint">tap to interact</span></div>
<div id="project-label"></div>
<div id="crosshair"></div>
<div id="zone-hint"></div>

<div id="quest-log">
  <div class="quest-header"><span class="quest-icon">❯</span> TELEPORT <button id="quest-toggle">▼</button></div>
  <div id="quest-list"></div>
  <div class="quest-progress"><div class="quest-bar"><div id="quest-fill"></div></div><span id="quest-count">0 / 8</span></div>
  <button id="quest-reset">↻ reset</button>
</div>

<button id="tw-toggle">+</button>
<div id="tw-panel" class="tw-closed">
  <div id="tw-title">❯ SETTINGS</div>
  <button id="tw-close">×</button>
  <div class="tw-label">TIME</div>
  <div class="tw-row">
    <button data-time="auto" class="tw-on">auto</button>
    <button data-time="dawn">dawn</button>
    <button data-time="day">day</button>
    <button data-time="sunset">dusk</button>
    <button data-time="night">night</button>
  </div>
  <div class="tw-label">WEATHER</div>
  <div class="tw-row">
    <button data-weather="clear" class="tw-on">clear</button>
    <button data-weather="rain">rain</button>
    <button data-weather="snow">snow</button>
  </div>
  <div class="tw-label">CHARACTER</div>
  <div class="tw-row">
    <button data-skin="0" title="Bunny">bunny</button>
    <button data-skin="1" title="Frog">frog</button>
    <button data-skin="2" title="Bear">bear</button>
    <button data-skin="3" title="Robot">robot</button>
    <button data-skin="4" title="Penguin">pengu</button>
  </div>
  <div class="tw-label">SEASON</div>
  <div class="tw-row">
    <button data-season="spring">spring</button>
    <button data-season="summer" class="tw-on">summer</button>
    <button data-season="autumn">autumn</button>
    <button data-season="winter">winter</button>
  </div>
</div>

<div id="minigame-container" style="display:none;position:absolute;inset:0;z-index:25;"></div>
<div id="joystick-base"><div id="joystick-thumb"></div></div>
<button id="mobile-jump">▲</button>
<button id="mobile-interact">E</button>
<div id="fps"></div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('tw-panel');
    const toggle = document.getElementById('tw-toggle');
    const closeBtn = document.getElementById('tw-close');
    if (!panel || !toggle || !closeBtn) return;

    toggle.addEventListener('click', () => {
      panel.classList.remove('tw-closed');
      toggle.style.display = 'none';
    });
    closeBtn.addEventListener('click', () => {
      panel.classList.add('tw-closed');
      toggle.style.display = 'flex';
    });
  });
</script>
<script>
  import { init } from "../scripts/main";
  init();
</script>
</body>
</html>